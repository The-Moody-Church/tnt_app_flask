# Copy to .env for local development (python tnt.py loads it). Never commit real values.

# --- App ---
# Random, 32+ chars; different per environment. python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Optional: comma-separated previous keys during rotation
SECRET_KEY_FALLBACKS=
# Exact origin registered on the MP API client (no trailing slash)
APP_BASE_URL=http://localhost:5001
# Shown on the login / not-authorized pages
HELP_CONTACT=the Awana director
# Non-production only: pretend today is this date (YYYY-MM-DD). ?today=YYYY-MM-DD also works per browser.
TNT_DATE_OVERRIDE=

# --- Database (Neon) ---
# Pooled (-pooler) host, least-privilege role tnt_app. The only DB variable set on Vercel.
DATABASE_URL=postgresql://tnt_app:password@ep-xxxx-pooler.us-east-2.aws.neon.tech/tnt?sslmode=require&channel_binding=require
# Owner role on the DIRECT host: migrations and the sheet import only. Never set on Vercel.
DATABASE_URL_UNPOOLED=

# --- MinistryPlatform ---
MINISTRY_PLATFORM_BASE_URL=https://moody.ministryplatform.com/ministryplatformapi
# The dedicated TNT API client (used for both sign-in and server-to-server calls)
MP_CLIENT_ID=
MP_CLIENT_SECRET=
MP_OIDC_SCOPES=openid http://www.thinkministry.com/dataplatform/scopes/all
# 1 sends PKCE (S256). Leave 0 unless the client is confirmed to accept it.
MP_OIDC_PKCE=0
# Group 1000 = T&T Leaders (who may sign in); 697 = T&T kids (the roster). Kid role = Group_Role_ID 2.
MP_LEADER_GROUP_ID=1000
MP_ROSTER_GROUP_ID=697
MP_KID_ROLE_IDS=2
# Comma-separated MP security User Group IDs whose members may also sign in (staff/admins)
ADMIN_USER_GROUP_IDS=
# Team assignment writes Group_Participants.Notes back to MP. Defaults on only in production.
MP_WRITES_ENABLED=0
